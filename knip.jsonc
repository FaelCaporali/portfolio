{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Ferramentas de linha de comando do estúdio 3D (medição, captura, atlas, otimização): cada script é uma entrada.
  "entry": [
    "3d/tools/**/*.mjs",
    // Página da trajetória: journey.html carrega main.ts; o render é carregado pelo vite.config.ts por caminho
    // (runnerImport), que o knip não segue.
    "src/features/journey/main.ts",
    "src/features/journey/render.tsx"
  ],
  "ignore": [
    // Arquivo histórico: site da v7 do financeiro, recusada em 24/09 e guardada como referência (não é importada).
    "3d/tools/props/financeiro/site-v7/**"
  ],
  // Programas do sistema chamados pelas ferramentas de prova (não são pacotes npm).
  "ignoreBinaries": ["inkscape", "convert"],
  // O script `pnpm knip` define VITE_TURNSTILE_SITEKEY: o vite.config.ts recusa carregar em modo de build sem a chave
  // pública, e o knip carrega a config para achar os plugins. O valor não vai para build nenhum.
  "ignoreDependencies": [
    // Módulos virtuais do runtime (cloudflare:test, cloudflare:workers), fornecidos pelo workerd, não pelo npm.
    "cloudflare"
  ]
}
