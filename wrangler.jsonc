{
  // Um Worker só: serve o site (build do Vite) e a API do formulário de contato no mesmo endereço.
  // Mesmo endereço = sem CORS, Turnstile confere um hostname fixo e a CSP cobre tudo. Detalhes em docs/CONTATO.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fael-caporali",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "routes": [{ "pattern": "fael.caporali.dev", "custom_domain": true }],
  // O MCP para os agentes mora em fael-caporali.rafaelhon.workers.dev/mcp, fora da zona e do Bot Fight Mode (D-MCP11,
  // .wai/mcp/02-plano.md); lá o Worker só responde ao MCP e manda o resto para o site (worker/index.ts). Arquivos
  // estáticos fora do run_worker_first saem direto também nesse endereço.
  "workers_dev": true,
  "preview_urls": false,
  // O site: as páginas pré-renderizadas e os arquivos do build do React Router (pnpm build). O wrangler empacota o
  // Worker direto de worker/index.ts. /journey serve journey/index.html sem a barra no fim (drop-trailing-slash);
  // endereço que não existe cai no Worker como 404 e ganha a página "Page not found" do roteador (worker/index.ts).
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    // A API e as páginas HTML acordam o Worker (a página ganha a CSP com nonce, worker/page.ts). Arquivos estáticos
    // saem direto dos assets, sem consumir requisições do plano.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/cv/*",
      "!/og/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/apple-touch-icon.png"
    ]
  },
  // Envio grátis só para destino verificado. Destino e remetente fixos na binding: mesmo com o código explorado,
  // o Worker não consegue mandar e-mail para mais ninguém nem em nome de outro endereço.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "fael@caporali.dev",
      "allowed_sender_addresses": ["worker@mail.caporali.dev"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fael-caporali",
      "database_id": "47468d59-26bb-49b0-95da-f22b963f79e2",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Contato: por IP, por data center, 3 envios por minuto. MCP: por rede (ASN), por data center, 60 chamadas por minuto;
  // por IP não serve, porque no Claude e no ChatGPT todos chegam pelos IPs do provedor (worker/mcp/route.ts).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Registro de visitas (POST /api/e): por IP, 30 por minuto. Cada página manda um só, ao esconder ou ao trocar.
    { "name": "VISITS_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Registro de visitas do site (worker/visits.ts, .wai/monitoramento/02-plano.md): Analytics Engine, grátis no plano
  // Free (100 mil pontos por dia), cota própria, 3 meses de retenção. O conjunto é criado na primeira escrita.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "fael_caporali_visits" }],
  // Registro do MCP acima da cota do dia: a chamada espera na fila até a cota do dia seguinte abrir e é gravada pelo
  // consumidor deste mesmo Worker (worker/mcp/audit.ts, D-MCP26). Plano grátis: 10 mil operações por dia e até 24 h na
  // fila. Lote de 20: até 2 consultas ao D1 por mensagem, abaixo das 50 por invocação do plano grátis. 30 tentativas
  // cobrem as 24 h da fila com o banco fora do ar (1 h entre elas). O wrangler deploy cria a fila se ela não existir.
  "queues": {
    "producers": [{ "binding": "MCP_LOG", "queue": "fael-caporali-mcp-log" }],
    "consumers": [
      { "queue": "fael-caporali-mcp-log", "max_batch_size": 20, "max_batch_timeout": 30, "max_retries": 30 }
    ]
  },
  // Reenvio do que ficou pendente, limpeza do que passou de 90 dias e o resumo semanal do site e do MCP (worker/cron.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://fael.caporali.dev",
    "TURNSTILE_HOSTNAMES": "fael.caporali.dev",
    "ALLOW_TEST_TURNSTILE": "0",
    // Conta da Cloudflare, para o resumo semanal ler as visitas pela API SQL do Analytics Engine. O token (secret
    // CF_API_TOKEN, "Account Analytics: Read") é passo manual: `wrangler secret put CF_API_TOKEN`.
    "CF_ACCOUNT_ID": "92c5718d3afa29fd2f999d6a935daf95"
  },
  "observability": { "enabled": true }
}
